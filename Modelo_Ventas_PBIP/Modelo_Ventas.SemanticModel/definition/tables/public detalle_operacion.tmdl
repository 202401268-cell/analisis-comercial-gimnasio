table 'public detalle_operacion'
	lineageTag: 5663924d-6d6d-4b2c-ae2b-b0adcbf58711

	measure 'Ventas Brutas' =
			
			SUMX(
			    'public detalle_operacion',
			    'public detalle_operacion'[Cantidad] *
			    'public detalle_operacion'[Precio Unitario]
			)
		lineageTag: a0d263be-b93b-4d66-b1fa-57827dfb170b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Operaciones' =
			
			DISTINCTCOUNT('public operaciones'[Operación ID])
		formatString: 0
		lineageTag: a67beb3b-2a78-4568-888f-f189b1cac53d

	measure 'Clientes Activos' =
			
			CALCULATE(
			    DISTINCTCOUNT('public operaciones'[Cliente ID]),
			    NOT ISBLANK('public operaciones'[Cliente ID])
			)
		formatString: 0
		lineageTag: 294d9c2a-467f-400e-98bd-aa5ca39882c9

	measure 'Unidades Vendidas' =
			
			SUM('public detalle_operacion'[Cantidad])
		formatString: 0
		lineageTag: 1965b2b2-de35-4e61-a747-420db150c597

	column 'Detalle ID'
		dataType: int64
		formatString: 0
		lineageTag: 7fed1ded-231a-461b-889e-a4b0f10cd1c8
		summarizeBy: count
		sourceColumn: Detalle ID

		annotation SummarizationSetBy = Automatic

	column 'Operación ID'
		dataType: int64
		formatString: 0
		lineageTag: 997efc62-02b3-498c-a16f-9587b0c9cc2a
		summarizeBy: none
		sourceColumn: Operación ID

		annotation SummarizationSetBy = Automatic

	column 'Producto ID'
		dataType: int64
		formatString: 0
		lineageTag: 7303449e-f5b4-4bae-8eb4-e889e5cc7361
		summarizeBy: none
		sourceColumn: Producto ID

		annotation SummarizationSetBy = Automatic

	column Cantidad
		dataType: int64
		formatString: 0
		lineageTag: 8e453a7d-713d-444a-a300-abed079202b6
		summarizeBy: sum
		sourceColumn: Cantidad

		annotation SummarizationSetBy = Automatic

	column 'Precio Unitario'
		dataType: double
		lineageTag: 0c910771-fb7a-4fea-b400-b19b8934acc2
		summarizeBy: sum
		sourceColumn: Precio Unitario

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Descuento
