		summarizeBy: none
		sourceColumn: precio_lista

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'public catalogo' = m
		mode: import
		source =
				let
				  Origen = PostgreSQL.Database("ep-floral-sky-bece9d9r-pooler.c-9.us-east-2.aws.neon.tech", "gimnasio"),
				  #"Navegación 1" = Origen{[Schema = "public", Item = "catalogo"]}[Data]
				in
				  #"Navegación 1"

	annotation PBI_ResultType = Table

